{
  "name": "app-pauses",
  "version": "1.0.0",
  "description": "Gestion des temps de pause - centre d'appels",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.js",
    "start": "node dist/server.js",
    "dev": "npm run build && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/server.js\"",
    "seed": "node scripts/seed.js",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "iconv-lite": "^0.7.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}
