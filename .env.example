# Serveur
PORT=3000

# Superviseur (repli si app_settings.supervisor_pin absent ou vide — défini en base par npm run seed)
SUPERVISOR_PIN=1234

# MariaDB — fourni par docker-compose.yml ; à renseigner seulement hors compose (Node à la main, Podman)
# DATABASE_URL=mysql://flowi:flowi@127.0.0.1:3306/flowi

# Quotas par défaut (si non renseigné en base)
DEFAULT_QUOTA=2

# Durée maximale d'une pause en minutes
MAX_PAUSE_MINUTES=15

# Rétention historique en jours
HISTORY_RETENTION_DAYS=30

# OTA GitHub
GITHUB_OWNER=
GITHUB_REPO=
UPDATE_SCRIPT_PATH=./scripts/update.sh
RESTART_COMMAND=pm2 restart app-pauses

# Fixi (signalement de bugs) — vide = widget désactivé
# Ex. FIXI_WIDGET_URL=https://fixi.duckdns.org/widget.js
# Après modification en production : docker compose up -d --build (restart ne relit pas .env)
FIXI_WIDGET_URL=
FIXI_API_KEY=
